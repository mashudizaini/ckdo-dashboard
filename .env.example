# ─────────────────────────────────────────
# APPLICATION
# ─────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=CKDO Dashboard
APP_URL=http://localhost

# ─────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────
POSTGRES_USER=ckdo_user
POSTGRES_PASSWORD=changeme_postgres
DATABASE_URL=postgresql://ckdo_user:changeme_postgres@postgres:5432/ckdo_dashboard

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_URL=redis://:changeme_redis@redis:6379/0
CELERY_BROKER_URL=redis://:changeme_redis@redis:6379/1
CELERY_RESULT_BACKEND=redis://:changeme_redis@redis:6379/2

# ─────────────────────────────────────────
# KEYCLOAK
# ─────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=ckdo
KEYCLOAK_CLIENT_ID=ckdo-dashboard
KEYCLOAK_CLIENT_SECRET=changeme_client_secret

# ─────────────────────────────────────────
# ORACLE EBS
# ─────────────────────────────────────────
ORACLE_HOST=172.21.2.201
ORACLE_PORT=1521
ORACLE_SERVICE=PROD
ORACLE_USER=apps
ORACLE_PASSWORD=changeme_oracle
ORACLE_INSTANT_CLIENT=/opt/oracle/instantclient

# ─────────────────────────────────────────
# TALENTA HR API
# ─────────────────────────────────────────
TALENTA_API_KEY=changeme_talenta
TALENTA_API_URL=https://api.talenta.co

# ─────────────────────────────────────────
# ANTHROPIC
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-changeme

# ─────────────────────────────────────────
# FRONTEND (Vite env vars — prefix VITE_)
# ─────────────────────────────────────────
VITE_API_URL=http://localhost/api/v1
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ckdo
VITE_KEYCLOAK_CLIENT_ID=ckdo-dashboard
