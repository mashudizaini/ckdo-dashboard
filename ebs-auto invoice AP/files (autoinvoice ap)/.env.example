# Oracle DB — sama dengan ckdo-dashboard-v2
DB_USER=apps
DB_PASSWORD=your_password_here
DB_DSN=your_oracle_host:1521/your_service_name

# Oracle Instant Client — path di dalam container (sudah di-set di docker-compose)
ORACLE_INSTANT_CLIENT=/opt/oracle/instantclient_23_4

# EBS Constants
EBS_USER_ID=1110
EBS_RESP_ID=50738
EBS_RESP_APPL_ID=200
EBS_ORG_ID=81
EBS_SOURCE=XXCKD_PDF_IMPORT

# Upload dir di dalam container
UPLOAD_DIR=/app/uploads
